<!-- index.ejs -->
<html>
  <head>
    <title>Homepage</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <% messages.forEach((msg) => { %>
    <ol>
      <li>Message: <%= msg.text %></li>
      <li>User: <%= msg.user %></li>
      <li>Joined: <%= msg.added %></li>
    </ol>
    <% }); %>
  </body>
</html>
