<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <ul>
      <% for( let i = 0; i < user.length; i++ ) { %>
      <li>Name: <%= user[i].username %></li>
      <% } %>
    </ul>
    <% if (Object.keys(locals.user).length === 0) { %>
    <h3>User doesn't exists</h3>
    <% } %>
    <a href="/">Search another</a>
  </body>
</html>
